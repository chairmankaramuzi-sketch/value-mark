# Value Mark — environment variables (PLACEHOLDERS ONLY).
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# Display name used in the UI until company settings exist (Phase B9).
COMPANY_DISPLAY_NAME="Value Mark"

# Development-only demo session for exercising navigation/roles before real
# authentication exists. Ignored in production builds. Set to "false" or remove
# once Phase B2 (authentication) is complete.
DEMO_AUTH_ENABLED="false"

# --- Added in later phases (do not fill yet) ---
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public"   # Phase B1
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB"                     # Phase B1 (migrations)
# NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"             # Phase B2
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"                           # Phase B2
# SUPABASE_SERVICE_ROLE_KEY="server-only-secret"                          # Phase B4 (server only)
# STORAGE_BUCKET_PRIVATE="valuemark-private"                              # Phase B4
